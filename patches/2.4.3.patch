+unsigned NVRMNVDAFramebuffer::addScaledHiDpiModes(unsigned n)
+{
+    if (!nvrmScaledHiDpiEnabled() || !fMemBytes) return n;
+    NvrmEdidPanelMetadata panel = {};
+    if (!nvrmReadEdidPanelMetadata(fEdid, fEdidSize, &panel) || !panel.preferredW || !panel.preferredH) return n;
+    int seed = -1;
+    for (unsigned i = 0; i < n; ++i) {
+        const IODetailedTimingInformationV2 &d = fDT[i];
+        if (d.horizontalScaled || d.verticalScaled || d.horizontalActive != panel.preferredW ||
+            d.verticalActive != panel.preferredH) continue;
+        struct NvKmsKapiDisplayMode native = {};
+        if (!edidModeFor(&d, &native)) continue;
+        // Prefer the current boot timing when it is also the panel's preferred raster.
+        if (seed < 0) seed = (int)i;
+        if (native.timings.pixelClockHz == fBootMode.timings.pixelClockHz &&
+            native.timings.hVisible == fBootW && native.timings.vVisible == fBootH) {
+            seed = (int)i; break;
+        }
+    }
+    if (seed < 0) return n;
+    const unsigned before = n;
+    n = nvrmAppendScaledHiDpiTimings(fDT, n, sizeof fDT / sizeof fDT[0], (unsigned)seed,
+                                   fScalerMaxW, fScalerMaxH, fMemBytes, fPitchAlign, kIOScaleStretchToFit);
+    for (unsigned i = before; i < n; ++i)
+        FBLOG("fb%u HiDPI backing %ux%u -> native %ux%u as dt 0x%x", fIndex,
+              fDT[i].horizontalScaled, fDT[i].verticalScaled, fDT[i].horizontalActive,
+              fDT[i].verticalActive, fDT[i].detailedTimingModeID);
+    setProperty("NVRMHiDpiScaledModesAdded", (unsigned long long)(n - before), 32);
     return n;
